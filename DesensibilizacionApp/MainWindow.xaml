<Window x:Class="DesensibilizacionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesensibilizacionApp.ViewModels"
        mc:Ignorable="d"
        Title="ED-CVG - Test de Desensibilización a la Violencia Gráfica Digital (12-29 Años)"
        Height="820" Width="1050"
        MinHeight="700" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Status / Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#6366F1" CornerRadius="8" Width="36" Height="36" Margin="0,0,14,0">
                        <TextBlock Text="ED" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ED-CVG " FontWeight="Bold" FontSize="17" Foreground="#FFFFFF" />
                            <TextBlock Text="• Psicometría de Medios Digitales" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Escala Cuantitativa de Desensibilización ante Contenido Violento Gráfico (12 a 29 años)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Action Buttons in Top Bar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- History registry button -->
                    <Button Content="{Binding HistoryBadgeText}" 
                            Style="{StaticResource ModernSecondaryButton}" 
                            Command="{Binding OpenHistoryCommand}" 
                            Margin="0,0,12,0" Padding="14,7" FontSize="13" />

                    <!-- Badge Status -->
                    <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Instrumento Calibrado 2026" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN SCREENS CONTAINER -->
        <Grid Grid.Row="1" Margin="24">

            <!-- ======================================================== -->
            <!-- SCREEN 1: WELCOME & SETUP -->
            <!-- ======================================================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsWelcomeScreen, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="800" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,20">

                    <!-- Hero Presentation Card -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="16" Padding="24,20" Margin="0,0,0,16">
                        <StackPanel>
                            <Border Background="#266366F1" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="8" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="EVALUACIÓN CIENTÍFICA CUANTITATIVA" FontSize="11" FontWeight="Bold" Foreground="#818CF8" />
                            </Border>
                            <TextBlock Text="¿Qué tan habituado estás a la violencia gráfica en internet?" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="En la actualidad, algoritmos en redes sociales (TikTok, Reels de Instagram, feeds de X) exponen a adolescentes y jóvenes a peleas, choques y tragedias de forma inesperada. Paralelamente, foros o canales shock alimentan la curiosidad mórbida directa. Este test psicológico cuantifica con precisión tu índice numérico de desensibilización, analizando si proviene de una exposición involuntaria o de una búsqueda deliberada." 
                                       FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,16" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource BgDarkBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,8,0" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="📱 Consumo Indirecto (Algorítmico)" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" Margin="0,0,0,4" />
                                        <TextBlock Text="Aparición no solicitada en videos cortos, memes y grupos de mensajería." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="{StaticResource BgDarkBrush}" CornerRadius="10" Padding="14,12" Margin="8,0,0,0" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🔍 Consumo Directo (Activo)" FontWeight="Bold" FontSize="13" Foreground="#F472B6" Margin="0,0,0,4" />
                                        <TextBlock Text="Búsqueda intencional en Telegram, foros gore, o petición directa de enlaces crudos." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Participant Configuration Card -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="16" Padding="24,18">
                        <StackPanel>
                            <TextBlock Text="Configuración del Participante" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Alias -->
                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Text="Nombre o Alias (Opcional):" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding ParticipantAlias, UpdateSourceTrigger=PropertyChanged}" Height="38" />
                                </StackPanel>

                                <!-- Age Selection (12 to 29) -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Edad (12 a 29 años):" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding Ages}" SelectedItem="{Binding SelectedAge}" Height="38" />
                                </StackPanel>
                            </Grid>

                            <!-- Cohort Adaptive Information -->
                            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="Cohorte Adaptativa Asignada: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding CohortName}" FontWeight="Bold" FontSize="12" Foreground="#A78BFA" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CohortDescription}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Actions Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="Comenzar Test Psicológico (20 Reactivos) →" 
                                        Style="{StaticResource ModernPrimaryButton}" 
                                        Command="{Binding StartTestCommand}" 
                                        Height="44" FontSize="15" Margin="0,0,12,0" />

                                <Button Grid.Column="1" Content="📋 Ver Registro Histórico" 
                                        Style="{StaticResource ModernSecondaryButton}" 
                                        Command="{Binding OpenHistoryCommand}" 
                                        Height="44" FontSize="14" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- SCREEN 2: QUESTIONNAIRE RUNNER -->
            <!-- ======================================================== -->
            <Grid Visibility="{Binding IsQuestionnaireScreen, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <!-- Progress Bar & Dimension Badge -->
                    <RowDefinition Height="Auto" />
                    <!-- Question Card & Likert Options -->
                    <RowDefinition Height="*" />
                    <!-- Navigation Buttons -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Step Header & Progress -->
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{Binding DimensionBadgeColor, Converter={StaticResource ColorHexToBrush}}" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                <TextBlock Text="{Binding DimensionShortCode}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                            </Border>
                            <TextBlock Text="{Binding DimensionTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentQuestionNumberText}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Animated Progress Bar -->
                    <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Height="7" />
                </StackPanel>

                <!-- Question Main Card -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="16" Padding="32" VerticalAlignment="Center">
                        <StackPanel MaxWidth="820">

                            <!-- Question Statement -->
                            <TextBlock Text="{Binding CurrentQuestionText}" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" LineHeight="30" Margin="0,0,0,10" />

                            <!-- Context / Helper Tip -->
                            <Border Background="#08FFFFFF" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ℹ️ " FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentQuestion.ContextHint}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Selecciona el nivel que mejor represente tu experiencia o reacción habitual:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14" />

                            <!-- Likert 5 Options (Cards) -->
                            <StackPanel>

                                <!-- Option 1 -->
                                <Border Margin="0,0,0,10" CornerRadius="10" BorderThickness="1" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BgDarkBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SurfaceLightBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOption1Selected}" Value="True">
                                                    <Setter Property="Background" Value="#406366F1" />
                                                    <Setter Property="BorderBrush" Value="#6366F1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Background="Transparent" BorderThickness="0" Command="{Binding SelectOptionCommand}" CommandParameter="1" HorizontalContentAlignment="Stretch" Padding="16,12" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#334155" CornerRadius="6" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="1" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Totalmente en desacuerdo / Nunca" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </Border>

                                <!-- Option 2 -->
                                <Border Margin="0,0,0,10" CornerRadius="10" BorderThickness="1" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BgDarkBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SurfaceLightBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOption2Selected}" Value="True">
                                                    <Setter Property="Background" Value="#406366F1" />
                                                    <Setter Property="BorderBrush" Value="#6366F1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Background="Transparent" BorderThickness="0" Command="{Binding SelectOptionCommand}" CommandParameter="2" HorizontalContentAlignment="Stretch" Padding="16,12" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#334155" CornerRadius="6" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="2" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Rara vez / En muy pocas ocasiones" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </Border>

                                <!-- Option 3 -->
                                <Border Margin="0,0,0,10" CornerRadius="10" BorderThickness="1" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BgDarkBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SurfaceLightBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOption3Selected}" Value="True">
                                                    <Setter Property="Background" Value="#406366F1" />
                                                    <Setter Property="BorderBrush" Value="#6366F1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Background="Transparent" BorderThickness="0" Command="{Binding SelectOptionCommand}" CommandParameter="3" HorizontalContentAlignment="Stretch" Padding="16,12" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#334155" CornerRadius="6" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="3" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Ocasionalmente / A veces / Respuesta Neutral" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </Border>

                                <!-- Option 4 -->
                                <Border Margin="0,0,0,10" CornerRadius="10" BorderThickness="1" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BgDarkBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SurfaceLightBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOption4Selected}" Value="True">
                                                    <Setter Property="Background" Value="#406366F1" />
                                                    <Setter Property="BorderBrush" Value="#6366F1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Background="Transparent" BorderThickness="0" Command="{Binding SelectOptionCommand}" CommandParameter="4" HorizontalContentAlignment="Stretch" Padding="16,12" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#334155" CornerRadius="6" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="4" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Con frecuencia / Casi siempre" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </Border>

                                <!-- Option 5 -->
                                <Border Margin="0,0,0,0" CornerRadius="10" BorderThickness="1" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BgDarkBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SurfaceLightBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOption5Selected}" Value="True">
                                                    <Setter Property="Background" Value="#406366F1" />
                                                    <Setter Property="BorderBrush" Value="#6366F1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Background="Transparent" BorderThickness="0" Command="{Binding SelectOptionCommand}" CommandParameter="5" HorizontalContentAlignment="Stretch" Padding="16,12" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#334155" CornerRadius="6" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="5" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Totalmente de acuerdo / Siempre" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </Border>

                            </StackPanel>

                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- Navigation Controls -->
                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Previous Button -->
                    <Button Grid.Column="0" Content="← Pregunta Anterior" 
                            Style="{StaticResource ModernSecondaryButton}" 
                            Command="{Binding PreviousQuestionCommand}" 
                            Height="42" />

                    <!-- Next or Finish Button -->
                    <Button Grid.Column="2" Content="{Binding NextButtonText}" 
                            Style="{StaticResource ModernPrimaryButton}" 
                            Command="{Binding NextQuestionCommand}" 
                            Height="42" />
                </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- SCREEN 3: DIAGNOSTIC RESULTS DASHBOARD -->
            <!-- ======================================================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsResultsScreen, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="880" Margin="0,0,0,20">

                    <!-- Score Hero Card -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="16" Padding="32" Margin="0,0,0,20">
                        <StackPanel HorizontalAlignment="Center" TextBlock.TextAlignment="Center">
                            <Border Background="{Binding TestResult.Diagnostic.ColorHex, Converter={StaticResource ColorHexToBrush}}" CornerRadius="14" Padding="14,6" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="{Binding TestResult.Diagnostic.BadgeText}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" />
                            </Border>

                            <TextBlock Text="{Binding TestResult.GlobalIndex, StringFormat='{}{0:F1}%'}" FontSize="64" FontWeight="ExtraBold" Foreground="{Binding TestResult.Diagnostic.ColorHex, Converter={StaticResource ColorHexToBrush}}" Margin="0,4" />

                            <TextBlock Text="{Binding TestResult.Diagnostic.Title}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding TestResult.Diagnostic.Summary}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="680" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,14" />

                            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="8" Padding="14,8" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TestResult.RawTotalScore, StringFormat='Puntuación Bruta Acumulada: {0} de 100 puntos posibles'}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Subscales Breakdown (4 Cards Grid) -->
                    <TextBlock Text="Desglose por Subescalas Psicométricas (0% a 100%)" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Subscale 1: Passive -->
                        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,8,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="📱 Exposición Pasiva (Reels/Feeds)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding TestResult.PassiveExposureIndex, StringFormat='{}{0:F1}%'}" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Value="{Binding TestResult.PassiveExposureIndex, Mode=OneWay}" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Foreground="#38BDF8" Height="8" />
                                <TextBlock Text="Saturación imprevista por algoritmos de redes" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Subscale 2: Active -->
                        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="8,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="🔍 Búsqueda Activa e Intencional" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding TestResult.ActiveSeekingIndex, StringFormat='{}{0:F1}%'}" FontWeight="Bold" FontSize="14" Foreground="#F472B6" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Value="{Binding TestResult.ActiveSeekingIndex, Mode=OneWay}" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Foreground="#F472B6" Height="8" />
                                <TextBlock Text="Curiosidad mórbida, foros shock y canales gore" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Subscale 3: Physiological -->
                        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,8,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="🫀 Embotamiento Afectivo/Corporal" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding TestResult.PhysiologicalNumbingIndex, StringFormat='{}{0:F1}%'}" FontWeight="Bold" FontSize="14" Foreground="#A78BFA" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Value="{Binding TestResult.PhysiologicalNumbingIndex, Mode=OneWay}" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Foreground="#A78BFA" Height="8" />
                                <TextBlock Text="Falta de taquicardia, asco o impacto emocional" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Subscale 4: Normalization -->
                        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="8,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="🧠 Normalización y Falta de Empatía" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding TestResult.CognitiveNormalizationIndex, StringFormat='{}{0:F1}%'}" FontWeight="Bold" FontSize="14" Foreground="#FBBF24" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Value="{Binding TestResult.CognitiveNormalizationIndex, Mode=OneWay}" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Foreground="#FBBF24" Height="8" />
                                <TextBlock Text="Memes de tragedias, culpar a víctimas e indiferencia" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Consumption Dominance Banner -->
                    <Border Background="#206366F1" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="⚖️ Análisis Diferencial: ¿Consumo Pasivo vs Búsqueda Activa?" FontWeight="Bold" FontSize="14" Foreground="#818CF8" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding TestResult.ConsumptionDominanceAnalysis}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="20" />
                        </StackPanel>
                    </Border>

                    <!-- Behavioral Indicators, Cognitive Constructs and Recommendations -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,0,0,24">
                        <StackPanel>
                            <!-- Clinical Interpretation -->
                            <TextBlock Text="Diagnóstico Clínico y Fenomenología" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding TestResult.Diagnostic.ClinicalInterpretation}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16" />

                            <!-- Neurocognitive Profile -->
                            <Border Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="🔬 Perfil Neurocognitivo y Procesamiento Afectivo" FontWeight="Bold" FontSize="13" Foreground="#A78BFA" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding TestResult.Diagnostic.NeurocognitiveProfile}" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="19" />
                                </StackPanel>
                            </Border>

                            <!-- Operationalized Cognitive Constructs -->
                            <TextBlock Text="🧠 Constructos Psicológicos y Cognitivos Operacionalizados" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding TestResult.Diagnostic.AppliedCognitiveConstructs}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding ConstructName}" FontWeight="Bold" FontSize="13" Foreground="#818CF8" />
                                                    <Border HorizontalAlignment="Right" Background="{StaticResource SurfaceLightBrush}" CornerRadius="6" Padding="6,2">
                                                        <TextBlock Text="{Binding TheoreticalFramework}" FontSize="10.5" Foreground="#94A3B8" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding OperationalDefinition, StringFormat='Definición: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,4" />
                                                <Border Background="#1438BDF8" BorderBrush="#38BDF8" BorderThickness="2,0,0,0" Padding="8,4" CornerRadius="2">
                                                    <TextBlock Text="{Binding ManifestationInProfile, StringFormat='Manifestación en perfil: {0}'}" FontSize="11.5" Foreground="#38BDF8" TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Applied CBT Interventions -->
                            <TextBlock Text="💡 Intervenciones Cognitivo-Conductuales Aplicadas (TCC):" FontWeight="SemiBold" FontSize="14" Foreground="#10B981" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding TestResult.Diagnostic.AppliedInterventions}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="• " FontSize="14" Foreground="#10B981" />
                                            <TextBlock Text="{Binding}" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Recommendations -->
                            <TextBlock Text="🛡️ Recomendaciones de Higiene Neurocognitiva y Digital:" FontWeight="SemiBold" FontSize="14" Foreground="#38BDF8" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding TestResult.Diagnostic.PsychoeducationalRecommendations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="• " FontSize="14" Foreground="#38BDF8" />
                                            <TextBlock Text="{Binding}" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="🔄 Nueva Evaluación" 
                                        Style="{StaticResource ModernSecondaryButton}" 
                                        Command="{Binding RestartTestCommand}" Height="44" Margin="0,0,8,0" />

                                <Button Content="📋 Ver Historial de Tests" 
                                        Style="{StaticResource ModernSecondaryButton}" 
                                        Command="{Binding OpenHistoryCommand}" Height="44" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="📂 Ver Carpeta" 
                                        Style="{StaticResource ModernSecondaryButton}" 
                                        Command="{Binding OpenFolderCommand}" 
                                        Margin="0,0,8,0" Height="44" />

                                <Button Content="🌐 Abrir Reporte" 
                                        Style="{StaticResource ModernSecondaryButton}" 
                                        Command="{Binding OpenFileCommand}" 
                                        Visibility="{Binding HasExportedFile, Converter={StaticResource BoolToVis}}" 
                                        Margin="0,0,8,0" Height="44" />

                                <Button Content="📄 Exportar Informe" 
                                        Style="{StaticResource ModernSuccessButton}" 
                                        Command="{Binding ExportReportCommand}" Height="44" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- SCREEN 4: REGISTRO HISTÓRICO DE EVALUACIONES (NUEVO) -->
            <!-- ======================================================== -->
            <Grid Visibility="{Binding IsHistoryScreen, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <!-- Header with Back button -->
                    <RowDefinition Height="Auto" />
                    <!-- Split List + Detail View -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- History Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="← Volver" 
                            Style="{StaticResource ModernSecondaryButton}" 
                            Command="{Binding BackFromHistoryCommand}" 
                            Height="38" Padding="14,6" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Registro Histórico de Evaluaciones" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Consulta qué respondió cada participante reactivo por reactivo y analiza sus puntuaciones." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="{StaticResource SurfaceLightBrush}" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HistoryBadgeText}" FontWeight="Bold" FontSize="12" Foreground="#818CF8" />
                    </Border>
                </Grid>

                <!-- Split Main Container -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Left: List of all evaluations -->
                        <ColumnDefinition Width="340" />
                        <!-- Right: Detailed answers & results of selected test -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left List Card -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Participantes Evaluados" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="6,4,6,12" />

                            <!-- List of tests -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding HistoryTests}" SelectedItem="{Binding SelectedHistoryTest}" 
                                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="itemCard" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="itemCard" Property="BorderBrush" Value="#6366F1" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="itemCard" Property="BorderBrush" Value="#818CF8" />
                                                            <Setter TargetName="itemCard" Property="Background" Value="#25334E" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="{Binding ParticipantAlias}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                                <Border HorizontalAlignment="Right" Background="{Binding Diagnostic.ColorHex, Converter={StaticResource ColorHexToBrush}}" CornerRadius="8" Padding="7,2">
                                                    <TextBlock Text="{Binding GlobalIndex, StringFormat='{}{0:F1}%'}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Age, StringFormat='Edad: {0} años'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                            <Grid>
                                                <TextBlock Text="{Binding EvaluatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding Diagnostic.BadgeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding Diagnostic.ColorHex, Converter={StaticResource ColorHexToBrush}}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Right Inspector: Detailed results and questions table -->
                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                        <Grid>
                            <!-- If no test is selected -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasSelectedHistoryTest, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="No hay ningún test seleccionado" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Selecciona una evaluación de la lista izquierda o realiza un nuevo test." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- If a test IS selected -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelectedHistoryTest, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="0,0,10,0">

                                    <!-- Top Summary Banner -->
                                    <Border Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding SelectedHistoryTest.ParticipantAlias}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,12,0" />
                                                    <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedHistoryTest.Age, StringFormat='{}{0} años'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SelectedHistoryTest.Diagnostic.Title}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding SelectedHistoryTest.Diagnostic.ColorHex, Converter={StaticResource ColorHexToBrush}}" Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding SelectedHistoryTest.EvaluatedAt, StringFormat='Fecha de evaluación: {0:dd/MM/yyyy HH:mm:ss}'}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>

                                            <!-- Giant percentage -->
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedHistoryTest.GlobalIndex, StringFormat='{}{0:F1}%'}" FontSize="36" FontWeight="ExtraBold" Foreground="{Binding SelectedHistoryTest.Diagnostic.ColorHex, Converter={StaticResource ColorHexToBrush}}" HorizontalAlignment="Right" />
                                                <TextBlock Text="Índice de Desensibilización" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 4 Subscale Mini-Grid -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BgDarkBrush}" CornerRadius="8" Padding="12" Margin="0,0,6,8" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="📱 Exposición Pasiva (Reels)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding SelectedHistoryTest.PassiveExposureIndex, StringFormat='{}{0:F1}%'}" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ProgressBar Value="{Binding SelectedHistoryTest.PassiveExposureIndex, Mode=OneWay}" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Foreground="#38BDF8" Height="5" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BgDarkBrush}" CornerRadius="8" Padding="12" Margin="6,0,0,8" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="🔍 Búsqueda Activa (Mórbida)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding SelectedHistoryTest.ActiveSeekingIndex, StringFormat='{}{0:F1}%'}" FontWeight="Bold" FontSize="12" Foreground="#F472B6" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ProgressBar Value="{Binding SelectedHistoryTest.ActiveSeekingIndex, Mode=OneWay}" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Foreground="#F472B6" Height="5" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BgDarkBrush}" CornerRadius="8" Padding="12" Margin="0,0,6,0" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="🫀 Embotamiento Corporal" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding SelectedHistoryTest.PhysiologicalNumbingIndex, StringFormat='{}{0:F1}%'}" FontWeight="Bold" FontSize="12" Foreground="#A78BFA" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ProgressBar Value="{Binding SelectedHistoryTest.PhysiologicalNumbingIndex, Mode=OneWay}" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Foreground="#A78BFA" Height="5" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BgDarkBrush}" CornerRadius="8" Padding="12" Margin="6,0,0,0" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="🧠 Normalización y Empatía" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding SelectedHistoryTest.CognitiveNormalizationIndex, StringFormat='{}{0:F1}%'}" FontWeight="Bold" FontSize="12" Foreground="#FBBF24" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ProgressBar Value="{Binding SelectedHistoryTest.CognitiveNormalizationIndex, Mode=OneWay}" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Foreground="#FBBF24" Height="5" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Action Buttons for Selected Test -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Button Content="📄 Exportar Reporte HTML" 
                                                Style="{StaticResource ModernSuccessButton}" 
                                                Command="{Binding ExportSelectedHistoryReportCommand}" 
                                                Height="36" Padding="14,6" FontSize="13" Margin="0,0,10,0" />

                                        <Button Content="🗑️ Eliminar de la Base de Datos" 
                                                Style="{StaticResource ModernSecondaryButton}" 
                                                Command="{Binding DeleteHistoryTestCommand}" 
                                                Height="36" Padding="14,6" FontSize="13" />
                                    </StackPanel>

                                    <!-- Neurocognitive Profile in History -->
                                    <Border Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="🔬 Perfil Neurocognitivo del Participante" FontWeight="Bold" FontSize="13" Foreground="#A78BFA" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding SelectedHistoryTest.Diagnostic.NeurocognitiveProfile}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,10" />
                                            
                                            <TextBlock Text="Constructos Cognitivos Implicados:" FontWeight="SemiBold" FontSize="12" Foreground="#818CF8" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding SelectedHistoryTest.Diagnostic.AppliedCognitiveConstructs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#161F30" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding ConstructName}" FontWeight="Bold" FontSize="12" Foreground="#818CF8" />
                                                                    <TextBlock Text="{Binding TheoreticalFramework}" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Right" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding OperationalDefinition}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                                                <TextBlock Text="{Binding ManifestationInProfile, StringFormat='Manifestación: {0}'}" FontSize="11" Foreground="#38BDF8" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Question-by-Question Response Registry (What each participant answered) -->
                                    <TextBlock Text="Registro Individual de Reactivos Respondidos (20 Preguntas)" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10" />

                                    <Border Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                        <ItemsControl ItemsSource="{Binding SelectedHistoryTest.Answers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="34" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Question ID -->
                                                            <Border Grid.Column="0" Background="#334155" CornerRadius="6" Width="24" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding QuestionId}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>

                                                            <!-- Question Text -->
                                                            <StackPanel Grid.Column="1" Margin="6,0,14,0">
                                                                <TextBlock Text="{Binding QuestionText}" FontSize="13" Foreground="#FFFFFF" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,3" />
                                                                <TextBlock Text="{Binding ScoreLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                            </StackPanel>

                                                            <!-- Score Badge -->
                                                            <Border Grid.Column="2" Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Score, StringFormat='Puntaje: {0} / 5'}" FontWeight="Bold" FontSize="12" Foreground="#FBBF24" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                <TextBlock Text="ED-CVG v1.0 • .NET 9 C#" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
